  "acceptance": [
    {
      "feature": "F1",
      "req": "REQ-CORE-001",
      "test_class": "Gavel_TypeSafeProvider_Test",
      "scenarios": [
        "AS-1.1 validChoiceResponse",
        "AS-1.2 unknownOptionIsContractMismatch",
        "AS-1.3 keyNeverLeaks",
        "AS-1.4 aliasBlockedWhenLive"
      ],
      "script": "evals/acceptance/F1.sh"
    },
    {
      "feature": "F2",
      "req": "REQ-DEF-001",
      "test_class": "Gavel_DefinitionValidator_Test",
      "scenarios": [
        "AS-2.1 validDefinitionActivates",
        "AS-2.2 hashMismatchRejected",
        "AS-2.3 scoreLevelsMustStartAtZero"
      ],
      "script": "evals/acceptance/F2.sh"
    },
    {
      "feature": "F3",
      "req": "REQ-STATE-001",
      "test_class": "Gavel_StateBuilder_Test",
      "scenarios": [
        "AS-3.1 onlyAllowlistedFields",
        "AS-3.2 cardNumberRedacted",
        "AS-3.3 flsRespected",
        "AS-3.4 killSwitch"
      ],
      "script": "evals/acceptance/F3.sh"
    },
    {
      "feature": "F4",
      "req": "REQ-FLOW-001",
      "test_class": "Gavel_RunDecision_Test",
      "scenarios": [
        "AS-4.1 bulk200Async",
        "AS-4.2 screenFlowSync",
        "AS-4.3 errorSurfacesAsOutcome"
      ],
      "script": "evals/acceptance/F4.sh"
    },
    {
      "feature": "F5",
      "req": "REQ-POL-001",
      "test_class": "Gavel_PolicyEngine_Test",
      "scenarios": [
        "AS-5.1 marginBlocksAuto",
        "AS-5.2 escapeOption",
        "AS-5.3 shadowNeverActs",
        "AS-5.4 conservativeCombination"
      ],
      "script": "evals/acceptance/F5.sh"
    },
    {
      "feature": "F6",
      "req": "REQ-LEDG-001",
      "test_class": "Gavel_Ledger_Test",
      "scenarios": [
        "AS-6.1 errorStillLedgered",
        "AS-6.2 adminCannotEdit",
        "AS-6.3 tamperDetected"
      ],
      "script": "evals/acceptance/F6.sh"
    },
    {
      "feature": "F7",
      "req": "REQ-SHAD-001",
      "test_class": "Gavel_Shadow_Test",
      "scenarios": [
        "AS-7.1 agreementReport",
        "AS-7.2 promotionBlocked"
      ],
      "script": "evals/acceptance/F7.sh"
    },
    {
      "feature": "F8",
      "req": "REQ-CAL-001",
      "test_class": "Gavel_Calibration_Test",
      "scenarios": [
        "AS-8.1 overrideCaptured",
        "AS-8.2 recommendationMeetsTarget",
        "AS-8.3 noAutoChange"
      ],
      "script": "evals/acceptance/F8.sh"
    },
    {
      "feature": "F9",
      "req": "REQ-OPS-001",
      "test_class": "Gavel_Guardrails_Test",
      "scenarios": [
        "AS-9.1 budgetStopsCalls",
        "AS-9.2 breakerOpensAndCloses"
      ],
      "script": "evals/acceptance/F9.sh"
    },
    {
      "feature": "F10",
      "req": "REQ-AGT-001",
      "test_class": "Gavel_AgentforceGate_Test",
      "scenarios": [
        "AS-10.1 injectionBlocked",
        "AS-10.2 destructiveHeld",
        "AS-10.3 providerDownFailsClosed"
      ],
      "script": "evals/acceptance/F10.sh"
    },
    {
      "feature": "F11",
      "req": "REQ-SVC-001",
      "test_class": "Gavel_ServicePack_Test",
      "scenarios": [
        "AS-11.1 installsInShadow",
