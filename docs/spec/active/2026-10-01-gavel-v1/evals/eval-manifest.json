      "script": "evals/acceptance/F11.sh"
    },
    {
      "feature": "F12",
      "req": "REQ-SM-001",
      "test_class": "Gavel_SalesMarketingPack_Test",
      "scenarios": [
        "AS-12.1 hiddenOptOut",
        "AS-12.2 optOutNeverReversed",
        "AS-12.3 junkLeadShadow"
      ],
      "script": "evals/acceptance/F12.sh"
    },
    {
      "feature": "F13",
      "req": "REQ-PKG-001",
      "test_class": null,
      "scenarios": [
        "AS-13.1 sourceDeploy",
        "AS-13.2 packageInstall"
      ],
      "script": "evals/acceptance/F13.sh"
