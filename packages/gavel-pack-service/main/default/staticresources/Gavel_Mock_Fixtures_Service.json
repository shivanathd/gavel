  "Gavel_Case_Urgency": {
    "rules": [
      {
        "whenStateContains": [
          "payroll blocked",
          "production down",
          "outage",
          "fourth call",
          "third call",
          "resolved today",
          "cannot operate"
        ],
        "response": {
          "model": "mock-1.0.0",
          "answers": {
            "urgency": {
              "score": 3.6,
              "confidence": 0.9
            }
          }
        }
      },
      {
        "whenStateContains": [
          "just a question",
          "feedback",
          "suggestion",
          "when you get a chance"
        ],
        "response": {
          "model": "mock-1.0.0",
          "answers": {
            "urgency": {
              "score": 0.4,
              "confidence": 0.9
            }
          }
        }
      }
    ],
    "default": {
      "model": "mock-1.0.0",
      "answers": {
        "urgency": {
          "score": 1.6,
          "confidence": 0.7
        }
      }
    }
  },
  "Gavel_Closure_Check": {
    "rules": [
      {
        "whenStateContains": [
          "resolved",
          "fixed",
          "works now",
          "all good",
          "you can close"
        ],
        "response": {
          "model": "mock-1.0.0",
          "answers": {
            "customer_confirmed_resolved": {
              "probability": 0.93
            }
          }
        }
      }
    ],
    "default": {
      "model": "mock-1.0.0",
      "answers": {
        "customer_confirmed_resolved": {
          "probability": 0.2
        }
      }
    }
  },
  "Gavel_Reply_Check": {
    "default": {
      "model": "mock-1.0.0",
      "answers": {
        "support": {
