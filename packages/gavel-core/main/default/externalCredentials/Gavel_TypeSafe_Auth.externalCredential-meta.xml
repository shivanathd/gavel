<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>TypeSafe API key for Gavel. The key is entered by an admin on the Gavel_TypeSafe_Principal principal (parameter apiKey) and is stored only here.</description>
    <externalCredentialParameters>
        <parameterGroup>Gavel_TypeSafe_Principal</parameterGroup>
        <parameterName>Gavel_TypeSafe_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!'Bearer ' &amp; $Credential.Gavel_TypeSafe_Auth.apiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Gavel TypeSafe Auth</label>
</ExternalCredential>
